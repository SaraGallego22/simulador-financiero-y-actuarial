// Data model for the Simulador Financiero y Actuarial platform.
// See CLAUDE.md §7 for the rationale behind each modeling choice
// (cohort isolation, Bytes columns instead of a blob service, published flags).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEAM
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  team         Team?    @relation(fields: [teamId], references: [id])
  teamId       String?  @unique
  createdAt    DateTime @default(now())
}

model Cohort {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Highest day (1-4) teams can currently see, admin-controlled — teams start
  // scoped to Día 1 only and the admin advances this as the challenge
  // progresses (see updateOpenDayAction). Distinct from a day's own
  // TeamSimResult.published/MemberDayEvaluation.published: this gates whether
  // a day's tabs are reachable at all, not whether that day's results are out.
  openDay   Int      @default(1)

  teams          Team[]
  universeRuns   UniverseRun[]
  simulationRuns SimulationRun[]
  rubricConfig   RubricConfig?
}

model Team {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id])
  name      String
  color     String
  createdAt DateTime @default(now())

  user                     User?
  members                  TeamMember[]
  tariffSubmissions        TariffSubmission[]
  portfolioAllocations     PortfolioAllocation[]
  deliverables             Deliverable[]
  analyticsRecommendations AnalyticsRecommendation[]
  simResults               TeamSimResult[]
  softSkillActivityNotes   TeamActivityNote[]

  @@unique([cohortId, name])
}

model TeamMember {
  id            String  @id @default(cuid())
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name          String
  // Small headshot shown next to the member's name in subjective/soft-skills
  // grading — same bytea-in-Postgres approach as tariffs (see CLAUDE.md §3),
  // not a separate blob service. photoMimeType is stored alongside because a
  // data: URI must declare the right MIME type to render reliably across
  // browsers regardless of what was uploaded (jpeg/png/webp/...).
  photo         Bytes?
  photoMimeType String?

  evaluations          MemberDayEvaluation[]
  comments             MemberComment[]
  softSkillEvaluations SoftSkillEvaluation[]
  softSkillComments    SoftSkillComment[]
}

// Bulk-generated reference datasets (Colombia universe, Chile reference set).
// `data` holds the serialized typed array directly as a Postgres bytea column —
// no separate blob service (see CLAUDE.md §3/§4.1).
model UniverseRun {
  id         String    @id @default(cuid())
  cohortId   String
  cohort     Cohort    @relation(fields: [cohortId], references: [id])
  kind       String // "colombia" | "chile"
  seed       Int
  rowCount   Int
  status     JobStatus @default(PENDING)
  data       Bytes?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
}

// One market-clearing simulation run for a given challenge day/year.
// `resultData` is the full per-policy team assignment, kept only for audit/export;
// the numbers the UI actually queries live in TeamSimResult.
model SimulationRun {
  id         String    @id @default(cuid())
  cohortId   String
  cohort     Cohort    @relation(fields: [cohortId], references: [id])
  day        Int
  status     JobStatus @default(PENDING)
  params     Json
  resultData Bytes?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  teamResults TeamSimResult[]
}

model TeamSimResult {
  id              String        @id @default(cuid())
  simulationRunId String
  simulationRun   SimulationRun @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team          @relation(fields: [teamId], references: [id])

  insuredCount  Int
  totalPremium  Float
  claimsCount   Int
  claimsAmount  Float
  rejectedCount Int
  // Catch-all for the many finBench/almSim/scoreFinanciero output fields
  // (P&L lines, balance sheet, solvency ratios, NAV sensitivities) — kept as
  // Json until the engine port stabilizes their exact shape (see CLAUDE.md §7).
  extra         Json

  published Boolean @default(false)

  @@unique([simulationRunId, teamId])
}

model TariffSubmission {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  day         Int
  // Null when outsourced=true — the emergency tariff is a deterministic
  // function of the universe seed alone (see generateOutsourcedTariff() in
  // domain/pricing/outsourced.ts), so it's regenerated on demand instead of
  // storing another ~4MB bytea per team, exactly like the universe itself
  // (see CLAUDE.md §4.1).
  data        Bytes?
  meanPremium Float?
  // True when this team hit "Tercerizar tarifas" instead of uploading its
  // own CSV for this day — narratively, an emergency-outsourced tariff from
  // an inexperienced consultancy (see the outsource route's doc comment).
  outsourced  Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@unique([teamId, day])
}

model PortfolioAllocation {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  day         Int
  allocation  Json
  submittedAt DateTime @default(now())

  @@unique([teamId, day])
}

model Deliverable {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  day         Int
  conceptId   String
  value       Float
  submittedAt DateTime @default(now())

  @@unique([teamId, day, conceptId])
}

// A team's ranked pick within one of its two Día 4 sector lists — one row
// per (team, day, list, rank). A "sector" is a cross of two dimensions
// (dimA=valA x dimB=valB, e.g. zona=urbana x uso=comercial), not a single
// segment — see domain/grading/sectors.ts.
model AnalyticsRecommendation {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  day    Int
  list   String // 'crecer' | 'disminuir'
  rank   Int // 1-based position within that list
  dimA   String
  valA   String
  dimB   String
  valB   String
  // Team's own guess at this sector's true multiplier (aggregateLoss ÷
  // universe aggregateLoss) — optional, scored via a tolerance band exactly
  // like any other numeric estimate; null contributes 0 to that half of the
  // slot's score, same as leaving it blank. See scoreSectorPicks().
  estimatedMultiplier Float?

  @@unique([teamId, day, list, rank])
}

model RubricConfig {
  id       String @id @default(cuid())
  cohortId String @unique
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  subjectiveWeight Float  @default(0.30)
  actuarialWeight  Float  @default(0.50)
  objectiveMode    String @default("relative")
  tolerancePerfect Float  @default(0.05)
  toleranceZero    Float  @default(0.40)
}

enum EvaluationProfile {
  ACTUARIAL
  FINANCIERO
  GENERALISTA
}

// Per-participant subjective evaluation for one day. Only Días 2-4 — Día 1 has
// no subjective grade (not enough contact time yet to judge each member).
// `aprobado` is independent of `notaGeneral` (see composite.ts's notaDia:
// only notaGeneral feeds the numeric grade; aprobado/perfil/comentario are
// reporting fields the evaluator fills in alongside it).
model MemberDayEvaluation {
  id           String             @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember         @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  day          Int
  notaGeneral  Float? // 1.0-5.0, one decimal
  aprobado     Boolean?
  perfil       EvaluationProfile?
  // Standalone checkpoint toggle, independent of notaGeneral/aprobado/perfil —
  // does not feed any numeric grade (see composite.ts's notaDia), just a flag
  // an evaluator can mark per day.
  aptitudesRiesgos Boolean @default(false)

  published Boolean @default(false)

  @@unique([teamMemberId, day])
}

// Free-form remark on one participant for one day, authored by an
// evaluator. Unlike MemberDayEvaluation (one row per member/day, holding the
// scored fields), a member/day can have any number of these — several
// evaluators can each leave their own note without overwriting one another.
model MemberComment {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  day          Int
  author       String
  text         String
  createdAt    DateTime   @default(now())

  @@index([teamMemberId, day])
}

enum SoftSkillCompetency {
  TRABAJO_EQUIPO
  TRABAJO_PRESION
  ORIENTACION_LOGRO
  TOLERANCIA_FRUSTRACION
  COMUNICACION
  CREATIVIDAD
  LIDERAZGO
  PROACTIVIDAD
}

enum SoftSkillRating {
  EXCELENTE
  BUENO
  REGULAR
  NO_EVIDENCIA
}

// Per-participant qualitative rating on one of the 8 fixed competencies, for
// one of the 3 soft-skills activities (run in parallel to the técnica
// challenge — see src/lib/softSkills.ts). Internal to admin/TH only: unlike
// MemberDayEvaluation there is no `published` flag, teams never see this.
model SoftSkillEvaluation {
  id           String              @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember          @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  activity     Int // 1-3
  competency   SoftSkillCompetency
  rating       SoftSkillRating

  @@unique([teamMemberId, activity, competency])
}

// Free-form remark on one participant for one soft-skills activity, always
// authored by "Equipo TH" (see src/lib/softSkills.ts) — several can
// accumulate per member/activity, same append-only shape as MemberComment.
model SoftSkillComment {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  activity     Int
  text         String
  createdAt    DateTime   @default(now())

  @@index([teamMemberId, activity])
}

// Single editable note per team per soft-skills activity (not per member) —
// overwritten on save, unlike SoftSkillComment's append-only list.
model TeamActivityNote {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  activity  Int
  text      String
  updatedAt DateTime @updatedAt

  @@unique([teamId, activity])
}
